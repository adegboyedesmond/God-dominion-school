# ── Copy this file to .env and fill in your values ──

SECRET_KEY=put-a-long-random-string-here
# Your live website address (used in email links), e.g. https://goddominionschool.com
SITE_URL=

# ── Supabase database ──
# Supabase → Project Settings → Database → Connection string → URI (Transaction pooler, port 6543).
# Replace [YOUR-PASSWORD] with your database password. Leave empty only for local testing (SQLite).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# ── Supabase Storage (photos, homework files, applicant passports) ──
# Create a PUBLIC bucket named school-media. Key: Project Settings → API Keys → Secret key (sb_secret_...) or the legacy service_role key.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=school-media

# ── Flutterwave payments ──
# Flutterwave dashboard → Settings → API Keys. Use the TEST secret key first, then the LIVE one.
FLW_SECRET_KEY=
# Settings → Webhooks: set the URL to https://YOUR-SITE/flutterwave/webhook and type any secret hash here and there.
FLW_SECRET_HASH=

# ── Email ──
# On Render's FREE plan SMTP is blocked: use Brevo instead (free, 300 emails/day).
# Brevo → SMTP & API → API keys → create key. Also verify MAIL_FROM as a sender in Brevo.
BREVO_API_KEY=
# Otherwise (laptop, or paid Render plan) use any SMTP server:
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-letter App Password>
# Zoho: smtp.zoho.com 465 (set SMTP_SSL=1) · Brevo: smtp-relay.brevo.com 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_SSL=0

# First admin password (only used when the admin account is first created)
ADMIN_PASSWORD=admin123
